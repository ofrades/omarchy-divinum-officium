#!/usr/bin/env bash
# Smoke tests for the omarchy-divinum-officium plugin. Offline by default:
# the parser runs against tests/fixture-officium.html, and Model.js runs in
# node. Nothing here talks to a Divinum Officium server.
set -euo pipefail

cd "$(dirname "$0")/.."

echo "== python syntax =="
python3 -m py_compile divinum_officium.py
echo OK

echo "== parser (fixture) =="
python3 - <<'PY'
import importlib.util
import json

spec = importlib.util.spec_from_file_location("do", "divinum_officium.py")
do = importlib.util.module_from_spec(spec)
spec.loader.exec_module(do)

document = open("tests/fixture-officium.html", encoding="utf-8").read()
payload = do.parse_payload(document, {
    "baseUrl": "https://example.invalid",
    "date": "2026-09-23",
    "hour": "Prima",
    "version": "Rubrics 1960 - 1960",
    "lang1": "Latin",
    "lang2": "English",
})

assert payload["ok"] is True
assert payload["title"] == "Feria Quarta Quattuor Temporum Septembris ~ II. classis", payload["title"]
assert payload["colorKey"] == "purple", payload["colorKey"]
assert payload["colorName"] == "Violet", payload["colorName"]
assert payload["hourTitle"] == "Ad Primam", payload["hourTitle"]
assert payload["commemorations"] == ["Commemoratio ad Laudes tantum: S. Lini Papae et Martyris"], payload["commemorations"]
assert payload["sectionCount"] == 3, payload["sectionCount"]

first = payload["sections"][0]["columns"]
assert [len(column) for column in first] == [3, 3], first
assert first[0]["label"] == "Incipit" and first[1]["label"] == "Start"

lines = payload["sections"][1]["columns"][0]["lines"]
kinds = [line["k"] for line in lines]
assert kinds == ["rubric", "title", "verse"], kinds
assert lines[0]["marker"] == "Ant." and lines[0]["text"].startswith("Quem vidístis"), lines[0]
assert lines[1]["text"] == "Psalmus 53" and lines[1]["after"] == "[1]", lines[1]
assert lines[2]["marker"] == "53:3" and lines[2]["text"].startswith("Deus, in nómine"), lines[2]
assert payload["sections"][1]["columns"][0]["note"] == "Psalmi Dominica & antiphonae ex Proprio Sanctorum", payload["sections"][1]["columns"][0]["note"]

# The missal's green part numbers and both books' in-page jumps are chrome, not
# text; a popup link's words ("Communio") still belong to the office.
parts = payload["sections"][2]["columns"][0]["lines"]
assert [line["k"] for line in parts] == ["rubric", "text"], parts
assert parts[0]["marker"] == "P." and parts[0]["text"].startswith("O God,"), parts[0]
assert "Top" not in parts[0]["text"], parts[0]
assert parts[1]["text"] == "Communio", parts[1]
assert payload["sections"][2]["columns"][1]["lines"][0]["text"].startswith("O Deus,"), payload["sections"][2]["columns"][1]["lines"][0]

# A page without the body wrapper, as content=1 serves it.
partial = do.parse_payload(document[document.index("<P ALIGN"):], {"date": "2026-09-23"})
assert partial["title"].startswith("Feria Quarta"), partial["title"]

# A page with a black (white/ferial) headline: setfont omits COLOR for it.
black = document.replace('COLOR="purple"', "")
assert do.parse_payload(black, {})["colorName"] == "White"

# Date format round trip.
assert do.iso_to_do_date("2026-09-23") == "09-23-2026"
assert do.relative_date("today") != "today"

# The two rites, and the query each one builds.
import argparse

assert do.RITES["office"].endswith("Pofficium.pl"), do.RITES
assert do.RITES["mass"].endswith("missa.pl"), do.RITES

office_args = argparse.Namespace(hour="Prima", version="Rubrics 1960 - 1960", lang1="Latin", lang2="English")
office_params = do.rite_params("office", office_args, "2026-09-23")
assert office_params["command"] == "prayPrima", office_params
assert office_params["date1"] == "09-23-2026", office_params
assert "votive" not in office_params and "Propers" not in office_params, office_params

mass_args = argparse.Namespace(votive="C9", propers=True, version="Rubrics 1960 - 1960", lang1="Latin", lang2="English")
mass_params = do.rite_params("mass", mass_args, "2026-09-23")
assert mass_params["command"] == "pray", mass_params
assert mass_params["votive"] == "C9" and mass_params["Propers"] == "1", mass_params

hodie_args = argparse.Namespace(votive="Hodie", propers=False, version="Rubrics 1960 - 1960", lang1="Latin", lang2="English")
hodie_params = do.rite_params("mass", hodie_args, "2026-09-23")
assert "votive" not in hodie_params, hodie_params
assert hodie_params["Propers"] == "0", hodie_params
print("sections:", payload["sectionCount"], "| colour:", payload["colorName"], "| commemorations:", len(payload["commemorations"]))
PY
echo OK

echo "== helper cli =="
python3 divinum_officium.py cache-path | grep -q "divinum-officium" && echo OK

echo "== slice generator =="
python3 - <<'PY'
import importlib.util

spec = importlib.util.spec_from_file_location("generate_slice", "tools/generate_slice.py")
gen = importlib.util.module_from_spec(spec)
spec.loader.exec_module(gen)

assert gen.version_slug("Rubrics 1960 - 1960") == "rubrics-1960-1960", gen.version_slug("Rubrics 1960 - 1960")
assert gen.version_slug("Divino Afflatu - 1954") == "divino-afflatu-1954"
assert gen.version_slug("Monastic - 1963 - Barroux") == "monastic-1963-barroux"
assert gen.RITES["mass"].endswith("missa.pl") and gen.RITES["office"].endswith("Pofficium.pl")
hours = gen.HOURS
assert hours[0] == "Matutinum" and hours[-1] == "Completorium" and len(hours) == 8
print("slug:", gen.version_slug("Rubrics 1960 - 1960"), "| rites:", ",".join(sorted(gen.RITES)))
PY
echo OK

if command -v node >/dev/null 2>&1; then
  echo "== Model.js =="
  node -e "
const M = require('./Model.js');
// Node's console.assert only prints; these tests have to fail the run.
function check(ok, label) {
  if (!ok) throw new Error('Model.js: ' + label)
}
const s = M.parseSchedule(M.DEFAULT_SCHEDULE);
check(s.length === 8 && s[0] === 0, 'schedule parse');
check(M.hourForMinutes(s, 0).key === 'Matutinum', 'matins owns midnight');
check(M.hourForMinutes(s, 375).key === 'Laudes', 'lauds window');
check(M.hourForMinutes(s, 1439).key === 'Completorium', 'compline owns the night');
check(M.minutesToNextHour(s, 435) === 15, 'minutes to next hour');
check(M.nextHourForMinutes(s, 1290).key === 'Matutinum', 'compline wraps to matins');
check(M.formatDuration(130) === '2h 10m', 'duration');
check(M.parseSchedule('rubbish').join() === s.join(), 'bad schedule falls back');
check(M.parseSchedule('06:00,00:00,07:30,09:00,12:00,15:00,18:00,21:00').join() === s.join(), 'out-of-order schedule falls back');
check(M.dateKey(new Date(2026, 8, 23)) === '2026-09-23', 'dateKey');
check(M.shiftDateKey('2026-09-30', 1) === '2026-10-01', 'shift across month');
check(M.shiftDateKey('2026-01-01', -1) === '2025-12-31', 'shift across year');
check(M.longDate('2026-09-23') === 'Wednesday, 23 September 2026', 'long date');
check(M.colorSpec('black').name === 'White', 'DO black is the white class');
check(M.colorSpec('grey').name === 'Black', 'DO grey is black');
const rt = M.richText([
  { k: 'rubric', marker: '℣.', text: 'Deus in adiutórium' },
  { k: 'verse', marker: '53:3', text: 'Deus, in nómine tuo <salvum>' },
  { k: 'text', text: 'Glória Patri & Fílio' }
], { rubric: '#ff0000', verse: '#888888' });
check(rt.indexOf('<font color=\"#ff0000\">℣.</font>') === 0, 'rubric render');
check(rt.indexOf('&lt;salvum&gt;') > 0, 'escaping');
check(M.richText([{ k: 'verse', marker: '1:1', text: 'x' }], { verse: '#888', hideVerseNumbers: true }) === 'x', 'hide verses');
const sec = { columns: [{ label: '', note: '', lines: [] }, { label: 'Psalms', note: '{n}', lines: [{ k: 'text', text: 'x' }] }] };
check(M.sectionLabel(sec) === 'Psalms', 'label falls through columns');
check(M.sectionNote(sec) === '{n}', 'note');
check(M.parseOffice('') === null, 'empty output');
check(M.parseOffice('{nope').ok === false, 'bad json');
const cmd = M.riteCommand('/p/x.py', { rite: 'office', date: '2026-09-23', hour: 'Prima', baseUrl: 'https://d', version: 'V', lang1: 'Latin', lang2: 'English', ttl: 3600, refresh: true });
check(cmd[0] === 'python3' && cmd[2] === 'office', 'office subcommand');
check(cmd.indexOf('--hour') > 0 && cmd.indexOf('--votive') < 0, 'office asks for an hour only');
check(cmd[cmd.length - 1] === '--refresh', 'office refresh flag');
const mass = M.riteCommand('/p/x.py', { rite: 'mass', date: '2026-09-23', votive: 'C9', propersOnly: true, baseUrl: 'https://d', version: 'V', lang1: 'Latin', lang2: 'English', ttl: 3600 });
check(mass[2] === 'mass' && mass.indexOf('--hour') < 0, 'mass subcommand');
check(mass[mass.indexOf('--votive') + 1] === 'C9', 'votive code');
check(mass.indexOf('--propers') > 0, 'propers only flag');
const full = M.riteCommand('/p/x.py', { rite: 'mass', date: '2026-09-23', votive: 'Hodie', propersOnly: false, baseUrl: 'https://d', version: 'V', lang1: 'Latin', lang2: 'English', ttl: 3600 });
check(full.indexOf('--propers') < 0, 'full Mass keeps the Ordinary');
check(M.RITES.length === 2 && M.MASS_FORMS.length === 2 && M.VOTIVES.length >= 10, 'rite vocabulary');
check(M.VOTIVES[0].value === 'Hodie', 'Hodie is the Mass of the day');
// The bar names the day's Mass: the rank the server appends is dropped and the
// name is elided at a word boundary.
check(M.shortTitle('Feria Quarta Quattuor Temporum Septembris ~ II. classis') === 'Feria Quarta Quattuor Temporum…', 'rank dropped');
check(M.shortTitle('In Nativitate Domini ~ I. classis', 20) === 'In Nativitate Domini', 'fits, no elide');
check(M.shortTitle('Missa Defunctorum quotidianis: Requiem aeternam') === 'Missa Defunctorum quotidianis…', 'votive title');
check(M.shortTitle('Missa Defunctorum quotidianis: Requiem aeternam', 20) === 'Missa Defunctorum…', 'votive title, tight');
check(M.shortTitle('Easter', 12) === 'Easter', 'short stays short');
check(M.shortTitle('') === '', 'empty title');
const keyOne = M.massKey({ baseUrl: 'https://d', version: 'V', lang1: 'Latin', lang2: 'English', date: '2026-09-23', votive: 'Hodie', propers: true });
const keyTwo = M.massKey({ baseUrl: 'https://d', version: 'V', lang1: 'Latin', lang2: 'English', date: '2026-09-23', votive: 'C9', propers: true });
check(keyOne !== keyTwo, 'a votive changes the Mass key');
check(keyOne === M.massKey({ baseUrl: 'https://d', version: 'V', lang1: 'Latin', lang2: 'English', date: '2026-09-23', votive: 'Hodie', propers: true }), 'key is stable');
check(M.hourLabel('Vesperae') === 'Vesperae' && M.hourLabel('Vesperae', 'english') === 'Vespers', 'hour labels');
console.log('Model.js OK');
"
else
  echo "(node missing, skipping Model.js tests)"
fi

if command -v omarchy >/dev/null 2>&1; then
  echo "== omarchy plugin validate =="
  omarchy plugin validate .
  echo OK
else
  echo "(omarchy missing, skipping validate)"
fi

echo "== QML guards =="
# No optional-chaining / nullish-coalescing: not guaranteed in the QML engine.
if grep -n "?\.\|??" BarWidget.qml Panel.qml OfficeSection.qml Model.js; then
  echo "FAIL: unsupported JS syntax found" >&2
  exit 1
fi
echo OK

echo "ALL GREEN"
